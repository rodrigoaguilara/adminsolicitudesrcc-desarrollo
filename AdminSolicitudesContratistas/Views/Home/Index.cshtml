    @* 3. Tu lógica de negocio *@
    <script src="@Url.Content("~/Scripts/Functions/dashboard.js")"></script>

    @* 3. Ejecutar el código *@
    <script type="text/javascript">
        $(document).ready(function () {
            // Verificamos que el objeto exista antes de llamar a init
            if (typeof DashboardMOP !== 'undefined') {
                DashboardMOP.init();
            } else {
                console.error("No se pudo cargar DashboardMOP. Revisa la ruta del archivo js.");
            }
        });
    </script>
}

