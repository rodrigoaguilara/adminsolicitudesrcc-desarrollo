                <div class="col-sm-4">
                    <div class="row" id="rowPadding2">
                        <div>
                            <div>
                                <div class="">
                                    <div id="headerTextStyles">
                                        <div class="row mb-2">
                                            <div class="col-md-9">
                                                @*Bienvenido(a) <label id="lblUsername"> @Session["SessionNombreUsuario"] </label>*@
                                                Bienvenido(a) <label id="lblUsername"> @Session["SessionNombreUsuario"] </label>
                                                @Html.Hidden("hiddenUsernameAD", @Session["SessionUsernameAD"])
                                                @Html.Hidden("hiddenUserTipoRegistro", @Session["SessionUserTipoRegistro"])
