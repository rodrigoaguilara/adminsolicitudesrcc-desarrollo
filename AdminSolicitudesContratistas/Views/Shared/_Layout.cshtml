                                                @*<input type="hidden" id="hiddenUsernameAD" value="@Session["SessionUsernameAD"]" />*@
                                            </div>
                                            <div class="col-md-3">
                                                @*<div class="d-flex flex-row-reverse bd-highlight">*@
                                                <div class="d-flex bd-highlight">
                                                    @*@Html.ActionLink("Logout", "../Home/Logout")*@
