                                                        Salir
                                                        @*<span class="glyphicon glyphicon-plus-sign" aria-hidden="true"></span>*@
                                                        <i class="bi bi-box-arrow-right"></i>
                                                    </a>
                                                </div>


                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label id="lblPerfilUsuario"> @Session["SessionPerfilUsuario"] </label>
                                                @Html.Hidden("hiddenCodPerfil", @Session["SessionCodPerfil"])
                                            </div>
                                            <div class="col-md-6">
                                                <label id="lblTiempoSesion"> </label>
                                                <label id="lblTiempoRestanteSesion"> </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>




            </div>

            @{ var entorno = System.Configuration.ConfigurationManager.AppSettings["EntornoAplicacion"]; }
