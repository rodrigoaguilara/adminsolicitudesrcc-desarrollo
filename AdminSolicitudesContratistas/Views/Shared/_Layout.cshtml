    <!-- #region FUNCIONES CUSTOM JS QUE TIENEN QUE ESTAR ACÁ Y NO EN ARCHIVO -->


    <script>

        $(document).ready(function () {
            // Establece el idioma español para TODAS las operaciones de moment.js
            // en toda la aplicación.
            moment.locale('es');

            $('#btnHideAlertModal').on('click', function () {
                HideAlertModal();
            });

            function HideAlertModal() {
                //$('#alertModal').modal('hide');
                $('#alertModal').toggle();
            }

            //MANEJO DE SESSION TIME OUT EN JS
            $(document).ajaxError(function (e, xhr) {
                if (xhr.status == 401)
                    window.location = "../Home/Login";
                else if (xhr.status == 403)
                    alert("You have not enough permissions to request this resource.");
            });

            //// Get the session timeout value from the hidden field
            ////var sessionTimeoutMilliseconds = parseInt(document.getElementById("hiddenMinutosTimeoutms").value);
            var sessionTimeoutMilliseconds = $("#hiddenMinutosTimeoutms").val();

            // Start the countdown timer
            var timer = setTimeout(function () {
                // Redirect to the login page when the session expires
                window.location.href = '/Home/Login';
            }, sessionTimeoutMilliseconds);

            //MOSTRAR EL TIEMPO DE SESIÓN RESTANTE
            // Get the session timeout value from the hidden field
            var sessionTimeoutSeconds = parseInt($("#hiddenMinutosTimeoutms").val()) / 1000;

            // Function to format seconds into HH:MM:SS format
            function formatTime(seconds) {
                var hours = Math.floor(seconds / 3600);
                var minutes = Math.floor((seconds % 3600) / 60);
                var remainingSeconds = seconds % 60;

                return ("0" + hours).slice(-2) + ":" + ("0" + minutes).slice(-2) + ":" + ("0" + remainingSeconds).slice(-2);
            }

            // Update the label with the initial session time
            $("#lblTiempoSesion").text("Fin de sesión en " + formatTime(sessionTimeoutSeconds));

            // Start the countdown timer
            var timer = setInterval(function () {
                // Decrement the remaining session time
                sessionTimeoutSeconds--;

                // Update the label with the remaining session time
                $("#lblTiempoSesion").text("Fin de sesión en " + formatTime(sessionTimeoutSeconds));

                // If session timeout reaches 0, clear the timer
                if (sessionTimeoutSeconds <= 0) {
                    clearInterval(timer);
                }
            }, 1000); // Update every second




        });







    </script>

    <!-- #endregion -->




